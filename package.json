{
  "name": "sanium-ts-selenium",
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "mocha",
    "test:clean": "rm -rf allure-results allure-report mochawesome-report && npm test",
    "test:multi": "mocha --reporter mocha-multi-reporters --reporter-options configFile=multi-reporter-config.json",
    "test:multi:clean": "rm -rf allure-results allure-report mochawesome-report && npm run test:multi",
    "test:allure": "mocha --reporter allure-mocha",
    "test:allure:clean": "rm -rf allure-results allure-report && npm run test:allure",
    "test:mochawesome": "mocha --reporter mochawesome",
    "test:mochawesome:clean": "rm -rf mochawesome-report && npm run test:mochawesome",
    "report:allure": "allure generate allure-results --clean && allure open",
    "report:allure:open": "allure open allure-report",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:mochawesome": "xdg-open mochawesome-report/mochawesome.html || open mochawesome-report/mochawesome.html || start mochawesome-report/mochawesome.html",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "allure-mocha": "^2.10.0",
    "dotenv": "^16.3.1",
    "selenium-webdriver": "^4.21.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/selenium-webdriver": "^4.1.0",
    "allure-commandline": "^2.24.1",
    "chai": "^4.3.7",
    "chromedriver": "^141.0.6",
    "eslint": "^8.48.0",
    "eslint-config-standard-with-typescript": "^23.0.0",
    "geckodriver": "^4.1.0",
    "mocha": "^10.2.0",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.4",
    "mochawesome-report-generator": "^6.3.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
