{
  "name": "sanium-ts-selenium",
  "version": "0.1.0",
  "description": "TypeScript Selenium Framework with Playwright-style Auto-Wait",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "NODE_ENV=test mocha",
    "test:dev": "mocha",
    "test:example": "mocha tests/example.spec.ts",
    "test:allure": "NODE_ENV=test npx mocha --reporter allure-mocha",
    "test:mochawesome": "NODE_ENV=test npx mocha --reporter mochawesome",
    "test:multi": "NODE_ENV=test npx mocha --reporter mocha-multi-reporters --reporter-options configFile=multi-reporter-config.json",
    "test:parallel": "NODE_ENV=test npx mocha --parallel --jobs 4",
    "test:parallel:8": "NODE_ENV=test npx mocha --parallel --jobs 8",
    "test:parallel:multi": "NODE_ENV=test npx mocha --parallel --jobs 4 --reporter mocha-multi-reporters --reporter-options configFile=multi-reporter-config.json",
    "clean:reports": "rimraf mochawesome-report allure-results allure-report",
    "clean:test": "npm run clean:reports && npm run test:multi",
    "report:allure:generate": "allure generate allure-results -o allure-report --clean",
    "report:allure": "npm run report:allure:generate && npx allure open allure-report",
    "report:mochawesome": "open mochawesome-report/mochawesome.html",
    "report:all": "npm run report:mochawesome && npm run report:allure",
    "docs:clean": "rimraf docs-html",
    "docs:generate": "tsc scripts/generate-docs.ts --target ES2021 --module CommonJS --moduleResolution node --outDir . --skipLibCheck && node generate-docs.js",
    "docs:rebuild": "npm run docs:clean && npm run docs:generate",
    "docs:open": "open docs-html/index.html || opener docs-html/index.html",
    "docs": "npm run docs:rebuild && npm run docs:open"
  },
  "keywords": [
    "selenium",
    "typescript",
    "automation",
    "testing"
  ],
  "author": "SaniumTS Developer",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "selenium-webdriver": "^4.21.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/selenium-webdriver": "^4.1.0",
    "@types/winston": "^2.4.4",
    "allure-commandline": "^2.34.1",
    "allure-mocha": "^3.4.2",
    "chai": "^6.2.1",
    "chromedriver": "^141.0.6",
    "geckodriver": "^4.1.0",
    "mocha": "^10.8.2",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.4",
    "open": "^11.0.0",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  }
}
