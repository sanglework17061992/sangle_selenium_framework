{
  "name": "sanium-ts-selenium",
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "mocha -r ts-node/register tests/**/*.spec.ts --exit --grep 'Allure Report Demo' --invert",
    "test:allure-demo": "mocha -r ts-node/register tests/allure-demo.spec.ts --exit --timeout 60000 --reporter spec",
    "test:allure": "mocha -r ts-node/register tests/**/*.spec.ts --exit --reporter allure-mocha --timeout 60000",
    "report:allure": "allure generate allure-results --clean && allure open",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "allure-mocha": "^2.10.0",
    "dotenv": "^16.3.1",
    "selenium-webdriver": "^4.21.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/selenium-webdriver": "^4.1.0",
    "allure-commandline": "^2.24.1",
    "chai": "^4.3.7",
    "chromedriver": "^141.0.6",
    "eslint": "^8.48.0",
    "eslint-config-standard-with-typescript": "^23.0.0",
    "geckodriver": "^4.1.0",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
