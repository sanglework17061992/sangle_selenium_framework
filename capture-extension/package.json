{
  "name": "sangle-capture-extension",
  "version": "1.0.0",
  "description": "Maestro-like capture tool for recording test automation flows",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && webpack --mode production",
    "dev": "concurrently \"tsc --watch\" \"webpack --watch --mode development\"",
    "start": "node dist/server.js",
    "dev:server": "ts-node src/server.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "cors": "^2.8.5",
    "puppeteer-core": "^21.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "concurrently": "^8.2.2",
    "style-loader": "^3.3.3",
    "css-loader": "^6.8.1"
  }
}
