{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@config/*": ["config/*"],
      "@enums": ["types/Enums"],
      "@configTypes": ["types/ConfigTypes"],
      "@errorTypes": ["types/ErrorTypes"],
      "@types/*": ["types/*"],
      "@core/*": ["core/*"],
      "@driver/*": ["driver/*"],
      "@browser": ["browser"],
      "@browser/*": ["browser/*"],
      "@utils/*": ["utils/*"],
      "@assertion/*": ["assertion/*"],
      "@base/*": ["base/*"],
      "@reporting/*": ["reporting/*"],
      "@pages/*": ["pages/*"],
      "@tests/*": ["tests/*"],
      "@errors": ["errors/index"],
      "@errors/*": ["errors/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "ts-node": {
    "require": ["tsconfig-paths/register"],
    "transpileOnly": true,
    "compilerOptions": {
      "module": "CommonJS",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true
    }
  }
}