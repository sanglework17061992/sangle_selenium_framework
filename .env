# SaniumTS Selenium Framework Configuration
# Environment variables for test configuration

# Browser Configuration
BROWSER=chrome
HEADLESS=false
NO_SANDBOX=true

# Application URLs
BASE_URL=https://todomvc.com/examples/react/dist/

# Test Credentials
USERNAME=testuser
PASSWORD=testpass123

# Timeouts (in milliseconds)
DEFAULT_TIMEOUT=5000
ELEMENT_TIMEOUT=10000
PAGE_LOAD_TIMEOUT=30000

# Test Environment
ENVIRONMENT=qa
TEST_DATA_PATH=./test-data

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/test.log

# Retry Configuration
RETRY_COUNT=3
RETRY_INTERVAL=500

# Parallel Execution
# Controls Mocha's job-based parallelism for Selenium tests
# When true, runs test files concurrently within the same process
# When false, runs tests sequentially (recommended for Selenium tests)
# Note: Uses --jobs instead of --parallel to avoid WebDriver conflicts
PARALLEL=false
THREAD_COUNT=2

# Reporting
SCREENSHOT_ON_FAILURE=true
VIDEO_RECORDING=false

# Custom Browser Options
CHROME_ARGS=--disable-web-security,--disable-features=VizDisplayCompositor
FIREFOX_ARGS=-private