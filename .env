# SaniumTS Selenium Framework Configuration

# Browser Configuration
BROWSER=chrome
HEADLESS=false
NO_SANDBOX=true

# Application URLs
# To get the base URL, clone from https://github.com/sanglework17061992/test-webapp 
# Use `npm run start` and check the terminal output
BASE_URL=http://localhost:3001/

# Test Credentials
USERNAME=testuser
PASSWORD=testpass123

# Timeouts (in milliseconds)
DEFAULT_TIMEOUT=5000
ELEMENT_TIMEOUT=10000
PAGE_LOAD_TIMEOUT=30000

# Test Environment
ENVIRONMENT=qa
TEST_DATA_PATH=./test-data

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/test.log

# Retry Configuration
RETRY_COUNT=3
RETRY_INTERVAL=500

# Parallel Execution
PARALLEL=false
THREAD_COUNT=2

# Reporting
SCREENSHOT_ON_FAILURE=true
VIDEO_RECORDING=false
REPORTER_TYPE=allure

# Custom Browser Options
CHROME_ARGS=--disable-web-security,--disable-features=VizDisplayCompositor
FIREFOX_ARGS=-private